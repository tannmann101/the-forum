rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Same family allow-list as the sibling apps (household-ledger,
    // roc-workspace). Google sign-in proves who you are; this decides
    // whether you get in at all. Adding someone to the forum means adding
    // their address here and redeploying the rules -- there is no in-app
    // invite flow on purpose.
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'tannerwesgardner@gmail.com',
          'rochelleygardner@gmail.com'
        ];
    }

    // Writes always claim an author/actor, and it always has to be the
    // person actually signed in -- nobody gets to post or log activity
    // under someone else's name, even by hand from a console.
    function isSelf(uid) {
      return uid == request.auth.uid;
    }

    // You may change what you made, and only what you made. Read against
    // the EXISTING document, never the incoming one, so a rewrite of the
    // ownership field can't be used to grant yourself the edit.
    function ownsExisting(field) {
      return resource.data[field] == request.auth.uid;
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Ownership, authorship and creation time are never editable, on
    // anything. An edit changes what you said, not who said it or when.
    function identityIntact(ownerField, nameField, createdField) {
      return request.resource.data[ownerField] == resource.data[ownerField] &&
        request.resource.data[nameField] == resource.data[nameField] &&
        request.resource.data[createdField] == resource.data[createdField];
    }

    function isText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // Bodies are capped well under Firestore's 1 MiB document limit; the
    // composer enforces the same number so a too-long post fails in the
    // form rather than at the database.
    function isBody(v) {
      return isText(v, 20000);
    }

    function isOptionalNumber(d, key) {
      return !(key in d) || d[key] == null || d[key] is number;
    }

    function isOptionalString(d, key) {
      return !(key in d) || d[key] == null || d[key] is string;
    }

    function isOptionalBool(d, key) {
      return !(key in d) || d[key] == null || d[key] is bool;
    }

    // Attached images live in Cloud Storage (see storage.rules); what lands
    // here is only their metadata -- a URL, a path, a size, dimensions.
    // Checked as a capped list rather than field-by-field, the same way the
    // sibling apps type-check their nested structures: rules can't iterate
    // a list, and storage.rules is what actually governs the bytes.
    function attachmentsValid(d) {
      return !('attachments' in d) ||
        (d.attachments is list && d.attachments.size() <= 4);
    }

    // Shared shape for the archive flag, which categories, threads and
    // posts all carry. Archiving is how anything with other people's
    // content under it goes away: a delete would take their replies with
    // it, and would leave the activity log pointing at nothing.
    function archiveFieldsValid(d) {
      return isOptionalBool(d, 'archived') &&
        isOptionalNumber(d, 'archivedAt') &&
        isOptionalString(d, 'archivedBy');
    }

    // ---------- Categories ----------
    function isValidCategory(d) {
      return isText(d.name, 60) &&
        d.createdBy is string &&
        d.createdByName is string &&
        d.createdAt is number &&
        d.archived is bool &&
        d.order is number &&
        isOptionalNumber(d, 'archivedAt') &&
        isOptionalString(d, 'archivedBy') &&
        isOptionalNumber(d, 'editedAt');
    }

    match /categories/{categoryId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidCategory(request.resource.data) && isSelf(request.resource.data.createdBy);
      // Rename and archive/unarchive, by whoever created it. Never deleted:
      // threads hang off a category, and every activity-log breadcrumb
      // assumes the category it names still exists.
      allow update: if isAllowed() &&
        ownsExisting('createdBy') &&
        isValidCategory(request.resource.data) &&
        identityIntact('createdBy', 'createdByName', 'createdAt') &&
        changed(['name', 'archived', 'archivedAt', 'archivedBy', 'order', 'editedAt']);
      allow delete: if false;
    }

    // ---------- Threads ----------
    function isValidThread(d) {
      return d.categoryId is string &&
        isText(d.title, 140) &&
        d.createdBy is string &&
        d.createdByName is string &&
        d.createdAt is number &&
        d.lastActivityAt is number &&
        archiveFieldsValid(d) &&
        isOptionalNumber(d, 'editedAt');
    }

    match /threads/{threadId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidThread(request.resource.data) && isSelf(request.resource.data.createdBy);

      // Two separate update paths, deliberately.
      //
      // Anyone may bump lastActivityAt and nothing else -- that stamp is
      // what the thread list sorts on, and every new post, comment and
      // reply bumps it in the same batch as the content write. Requiring
      // ownership here would mean Rochelle replying to Tanner's thread
      // couldn't move it to the top of the list.
      //
      // The creator, separately, may retitle or archive it. A thread is
      // never deleted, for the same reason a category isn't.
      allow update: if isAllowed() && isValidThread(request.resource.data) && (
        changed(['lastActivityAt']) ||
        (
          ownsExisting('createdBy') &&
          identityIntact('createdBy', 'createdByName', 'createdAt') &&
          changed(['title', 'archived', 'archivedAt', 'archivedBy', 'editedAt', 'lastActivityAt'])
        )
      );
      allow delete: if false;
    }

    // ---------- Posts ----------
    function isValidPost(d) {
      return d.threadId is string &&
        d.categoryId is string &&
        d.authorId is string &&
        d.authorName is string &&
        isBody(d.body) &&
        d.isInitial is bool &&
        d.createdAt is number &&
        archiveFieldsValid(d) &&
        isOptionalNumber(d, 'editedAt') &&
        attachmentsValid(d);
    }

    match /posts/{postId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidPost(request.resource.data) && isSelf(request.resource.data.authorId);
      // Edit the body or archive it, author only. Archive rather than
      // delete: comments hang off a post, and deleting one would take
      // someone else's comments with it.
      allow update: if isAllowed() &&
        ownsExisting('authorId') &&
        isValidPost(request.resource.data) &&
        identityIntact('authorId', 'authorName', 'createdAt') &&
        request.resource.data.isInitial == resource.data.isInitial &&
        changed(['body', 'editedAt', 'archived', 'archivedAt', 'archivedBy']);
      allow delete: if false;
    }

    // ---------- Comments ----------
    // The one thing that really deletes. A comment with replies under it
    // is tombstoned instead (deleted:true, body replaced), so the replies
    // stay readable and in context; a childless one is removed outright.
    // The rules can't count replies, so they permit both shapes and the
    // client picks -- the activity log records which happened either way.
    function isValidComment(d) {
      return d.postId is string &&
        d.threadId is string &&
        d.categoryId is string &&
        d.authorId is string &&
        d.authorName is string &&
        isBody(d.body) &&
        d.createdAt is number &&
        isOptionalBool(d, 'deleted') &&
        isOptionalNumber(d, 'deletedAt') &&
        isOptionalNumber(d, 'editedAt') &&
        attachmentsValid(d);
    }

    match /comments/{commentId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidComment(request.resource.data) && isSelf(request.resource.data.authorId);
      allow update: if isAllowed() &&
        ownsExisting('authorId') &&
        isValidComment(request.resource.data) &&
        identityIntact('authorId', 'authorName', 'createdAt') &&
        changed(['body', 'editedAt', 'deleted', 'deletedAt', 'attachments']);
      allow delete: if isAllowed() && ownsExisting('authorId');
    }

    // ---------- Replies ----------
    // Replies never nest further, so there is never anything underneath to
    // strand: they delete outright, no tombstone case.
    function isValidReply(d) {
      return d.commentId is string &&
        d.postId is string &&
        d.threadId is string &&
        d.categoryId is string &&
        d.authorId is string &&
        d.authorName is string &&
        isBody(d.body) &&
        d.createdAt is number &&
        isOptionalNumber(d, 'editedAt') &&
        attachmentsValid(d);
    }

    match /replies/{replyId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidReply(request.resource.data) && isSelf(request.resource.data.authorId);
      allow update: if isAllowed() &&
        ownsExisting('authorId') &&
        isValidReply(request.resource.data) &&
        identityIntact('authorId', 'authorName', 'createdAt') &&
        changed(['body', 'editedAt']);
      allow delete: if isAllowed() && ownsExisting('authorId');
    }

    // ---------- Activity log ----------
    // One document per action, written in the same batch as the content it
    // describes -- so a post that exists always has a log entry, and a
    // failed write leaves neither behind.
    //
    // The log is still append-only even though the content no longer is.
    // That is the whole point: edits and deletes are themselves logged, so
    // removing something records that it was removed rather than quietly
    // erasing that it ever existed.
    function actionValues() {
      return [
        'category.create', 'category.rename', 'category.archive', 'category.unarchive',
        'thread.create', 'thread.rename', 'thread.archive', 'thread.unarchive',
        'post.create', 'post.edit', 'post.archive', 'post.unarchive',
        'comment.create', 'comment.edit', 'comment.delete',
        'reply.create', 'reply.edit', 'reply.delete'
      ];
    }

    function targetTypeValues() {
      return ['category', 'thread', 'post', 'comment', 'reply'];
    }

    // categoryId isn't part of the breadcrumb text on purpose: the Activity
    // Log page filters by category, and matching an id is exact where
    // matching a rendered breadcrumb string would break the moment someone
    // renames a category.
    function isValidActivity(d) {
      return d.actorId is string &&
        d.actorName is string &&
        d.action in actionValues() &&
        d.targetType in targetTypeValues() &&
        d.targetId is string &&
        d.breadcrumb is string &&
        d.createdAt is number &&
        isOptionalString(d, 'categoryId');
    }

    match /activityLog/{entryId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidActivity(request.resource.data) && isSelf(request.resource.data.actorId);
      allow update, delete: if false;
    }
  }
}
